# Copy this file to .env.local after cloning.
# Never commit .env.local or place real credentials in this template.

# Application
APP_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# Safety gates
# DATA_PROVIDER: mock | zhihu
# EXPERIMENT_MODE: dry-run | smoke | full
DATA_PROVIDER=mock
ALLOW_LIVE_EXTERNAL_CALLS=false
EXPERIMENT_MODE=dry-run

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=60000
DEEPSEEK_MAX_RETRIES=1
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=1200

# Zhihu Open Platform
ZHIHU_ACCESS_SECRET=
ZHIHU_API_BASE_URL=https://developer.zhihu.com
ZHIHU_SEARCH_COUNT=10
ZHIHU_TIMEOUT_MS=15000
ZHIHU_MAX_RETRIES=0

# Reproducible experiments
EXPERIMENT_SEED=20260904
EXPERIMENT_REPETITIONS=1
EXPERIMENT_OUTPUT_DIR=.runtime/experiments

# Mutable local state. Everything below .runtime is ignored by Git.
RUNTIME_STATE_DIR=.runtime/state
RUNTIME_CACHE_DIR=.runtime/cache
RUNTIME_TMP_DIR=.runtime/tmp
RUNTIME_LOG_DIR=.runtime/logs
RUNTIME_STATE_TTL_SECONDS=86400
CACHE_TTL_SECONDS=3600
