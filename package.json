{
  "name": "hackhack-life-experience-retrieval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "start:backend": "node src/server/main.mjs",
    "start:frontend": "node scripts/frontend-server.mjs",
    "dev": "node scripts/start-all.mjs",
    "test": "node --test --test-isolation=none \"tests/**/*.test.mjs\"",
    "test:unit": "node --test --test-isolation=none \"tests/unit/*.test.mjs\"",
    "test:contract": "node --test --test-isolation=none \"tests/contract/*.test.mjs\"",
    "test:integration": "node --test --test-isolation=none \"tests/integration/*.test.mjs\"",
    "test:quality": "node --test --test-isolation=none \"tests/quality/*.test.mjs\"",
    "test:zhihu": "node --test --test-isolation=none tests/unit/zhihu-search-client.test.mjs tests/unit/zhihu-provider.test.mjs tests/unit/retrieval-service.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:smoke:live": "node scripts/smoke.mjs --live",
    "experiment:zhihu": "node experiments/zhihu-retrieval-loop/run-experiment.mjs"
  }
}
